{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/no-unscoped-search.py\"",
            "timeout": 10,
            "statusMessage": "Checking that the search uses rg with a scope"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/no-python-outside-venv.py\"",
            "timeout": 10,
            "statusMessage": "Checking the interpreter against the project venv"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/no-cd.py\"",
            "timeout": 10,
            "statusMessage": "Checking that the command does not change directory"
          }
        ]
      }
    ]
  }
}
