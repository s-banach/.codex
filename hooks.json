{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/bash-rules.py\"",
            "timeout": 10,
            "statusMessage": "Checking the command against the Bash rules"
          }
        ]
      }
    ]
  }
}
