# Track AGENTS.md, hooks.json, run-check, the agents, and the hooks. Everything else here, config.toml included, is machine-local settings, session state, cache, or credentials.
# Ignore every path, then re-include each committed file by name.
# `*` also matches files inside a re-included directory, so each file there needs its own line.
*

!.gitignore
!AGENTS.md
!hooks.json

!bin/
!bin/run-check

!agents/
!agents/implementation-reviewer.toml
!agents/premise-reviewer.toml

!hooks/
!hooks/hook_testing.py
!hooks/shell_parsing.py
!hooks/bash-rules.py
!hooks/bash_rules_test.py
!hooks/no_python_outside_venv.py
!hooks/no_python_outside_venv_test.py
!hooks/no_unscoped_search.py
!hooks/no_unscoped_search_test.py
!hooks/no_cd.py
!hooks/no_cd_test.py
!hooks/no_chained_commit.py
!hooks/no_chained_commit_test.py
